{
  "manifest_version": 3,
  "name": "SPX BRIDGE",
  "version": "72.0.0",
  "description": "SPX Bridge for BACARRA HUB dashboard operations and Received Checking (v72).",
  "permissions": [
    "cookies",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://spx.shopee.ph/*",
    "https://*.susercontent.com/*",
    "https://*.file.susercontent.com/*",
    "https://*.github.io/*",
    "https://nol3-hubs.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://127.0.0.1/*",
        "https://*.github.io/*",
        "https://nol3-hubs.github.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "short_name": "SPX BRIDGE"
}
